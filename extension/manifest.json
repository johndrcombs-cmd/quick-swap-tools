{
  "manifest_version": 2,
  "name": "Quick Swap Tools",
  "version": "0.1.0",
  "description": "Low-latency auction and giveaway controls for Whatnot seller streams.",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "https://*.whatnot.com/*"
  ],
  "background": {
    "scripts": ["routing.js", "background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["https://*.whatnot.com/*"],
      "js": ["button_finder.js", "action_logic.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Quick Swap Tools"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "quick-swap-tools@onibyts.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
